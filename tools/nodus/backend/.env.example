# Copy to backend/.env for local runs (or use root .env with docker compose).
DATABASE_URL=sqlite+aiosqlite:///./nodus.db
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_DEBATE_MODEL=
LLM_GRAPH_MODEL=
LLM_MODERATOR_MODEL=
LLM_TIMEOUT_SEC=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Sandboxed code execution ─────────────────────────────────────────────
# Runs happen in a throwaway Docker container; there is no host-execution fallback.
SANDBOX_ENABLED=true
SANDBOX_DEFAULT_IMAGE=python:3.12-slim
SANDBOX_IMAGE=
SANDBOX_NETWORK=none
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_USER=
SANDBOX_WRITABLE=false
SANDBOX_MOUNT_SOURCE=
SANDBOX_TIMEOUT_SEC=120
SANDBOX_MAX_OUTPUT_CHARS=20000
SANDBOX_AGENT_COMMANDS=true
