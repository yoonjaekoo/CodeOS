/* Nodus TUI 스타일 — 화면: 채팅(왼) + 탭(오른쪽), 아래 상태줄·입력줄·키 안내 */

Screen {
    background: $surface;
}

#body {
    height: 1fr;
}

#chat {
    width: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#chat .msg {
    margin: 0 0 1 0;
    padding: 0 1;
}

.msg-system {
    color: $text-muted;
    border-left: thick $panel;
}
.msg-agent {
    border-left: thick $accent;
}
.msg-user {
    border-left: thick $success;
}
.msg-moderator {
    border-left: thick $warning;
}
.msg-execution {
    border-left: thick $secondary;
}
.msg-conclusion {
    border-left: thick $primary;
}

#side {
    width: 44%;
    min-width: 34;
    border-left: solid $panel;
    padding: 0 1;
}

#graph-text {
    padding: 0 1;
}

#exec-table,
#branch-table {
    height: 1fr;
}

#status {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

/* ── 모달 (새 프로젝트 / 확인) ─────────────────────────────────────────── */

NewProjectScreen,
ConfirmScreen {
    align: center middle;
    background: $background 70%;
}

#np-box,
#cf-box {
    width: 80;
    max-width: 96%;
    height: auto;
    max-height: 90%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#np-head {
    text-style: bold;
}

.np-row {
    height: auto;
}

.np-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.np-buttons {
    height: auto;
    margin-top: 2;
}

.np-buttons Button {
    margin-right: 1;
}

#cf-message {
    margin-bottom: 1;
}
