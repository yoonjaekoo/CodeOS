# Copy to .env and fill in. Never commit a real .env.
# Postgres (docker) — backend uses DATABASE_URL below instead.
# Local dev without docker: DATABASE_URL=sqlite+aiosqlite:///./nodus.db

DATABASE_URL=postgresql+asyncpg://nodus:nodus@localhost:5432/nodus

# Any OpenAI-compatible chat-completions endpoint works:
# OpenAI, OpenRouter, Groq, Gemini (compat endpoint), Ollama, vLLM…
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional per-role overrides (default: same as LLM_MODEL)
LLM_DEBATE_MODEL=
LLM_GRAPH_MODEL=
LLM_MODERATOR_MODEL=

LLM_TIMEOUT_SEC=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Sandboxed code execution ─────────────────────────────────────────────
# Commands run inside a throwaway Docker container (never on the host).
# If Docker is unavailable, execution is refused — Nodus never falls back to
# running project code directly on your machine.
SANDBOX_ENABLED=true
SANDBOX_DEFAULT_IMAGE=python:3.12-slim
# Force one image for every run (empty = auto-detect from the project stack).
SANDBOX_IMAGE=
SANDBOX_NETWORK=none
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
# e.g. 1000:1000. Empty = the image's own user.
SANDBOX_USER=
# Mount the project folder writable. false keeps the host tree untouchable.
SANDBOX_WRITABLE=false
# Only when this backend runs in a container while Docker runs on the host:
# the bind source the Docker daemon can see.
SANDBOX_MOUNT_SOURCE=
SANDBOX_TIMEOUT_SEC=120
SANDBOX_MAX_OUTPUT_CHARS=20000
# Let debate agents request runs with `@test` / `@run <command>`.
SANDBOX_AGENT_COMMANDS=true
