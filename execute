#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CS_FILE="$SCRIPT_DIR/CodeOS.Background.cs"
LOG_FILE="$SCRIPT_DIR/execute.log"

DOTNET_BIN=""
for candidate in "$HOME/.dotnet/dotnet" /usr/lib/dotnet/dotnet /usr/share/dotnet/dotnet /usr/local/share/dotnet/dotnet /opt/dotnet/dotnet; do
    if [[ -x "$candidate" ]]; then
        DOTNET_BIN="$candidate"
        break
    fi
done
if [[ -z "$DOTNET_BIN" ]] && command -v dotnet >/dev/null 2>&1; then
    DOTNET_BIN="$(command -v dotnet)"
fi

if [[ -z "$DOTNET_BIN" ]]; then
    echo "dotnet을 찾을 수 없습니다. .NET SDK를 설치하세요." >&2
    exit 1
fi

DOTNET_ROOT="$(dirname "$DOTNET_BIN")"
ENV_VARS=(DOTNET_ROOT="$DOTNET_ROOT" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1)

is_running() {
    curl -sf http://localhost:5890/status >/dev/null 2>&1
}

run_cli() {
    if [[ $EUID -eq 0 ]]; then
        env "${ENV_VARS[@]}" "$DOTNET_BIN" run --file "$CS_FILE" "$@"
    else
        sudo env "${ENV_VARS[@]}" "$DOTNET_BIN" run --file "$CS_FILE" "$@"
    fi
}

if [[ $# -eq 0 ]]; then
    # 서비스 모드: 백그라운드로 시작하고 즉시 프롬프트 복귀
    if is_running; then
        echo "CodeOS 백그라운드 서비스가 이미 실행 중입니다."
        exit 0
    fi

    echo "CodeOS 백그라운드 서비스를 시작합니다..."
    if [[ $EUID -eq 0 ]]; then
        env "${ENV_VARS[@]}" setsid nohup "$DOTNET_BIN" run --file "$CS_FILE" >"$LOG_FILE" 2>&1 </dev/null &
    else
        sudo env "${ENV_VARS[@]}" setsid nohup "$DOTNET_BIN" run --file "$CS_FILE" >"$LOG_FILE" 2>&1 </dev/null &
    fi

    # 첫 실행은 컴파일이 있어 몇 초 걸릴 수 있음
    for _ in $(seq 1 60); do
        if is_running; then
            echo "서비스 시작 완료! (http://localhost:5890)"
            echo
            echo "사용법:"
            echo "  ./execute status                  # 상태 확인"
            echo "  ./execute block add <도메인>     # 사이트 차단"
            echo "  ./execute block remove <도메인>  # 차단 해제"
            echo "  ./execute focus on|off           # 집중 모드"
            exit 0
        fi
        sleep 1
    done

    echo "서비스 시작 실패. 로그를 확인하세요: $LOG_FILE"
    exit 1
else
    run_cli "$@"
fi
