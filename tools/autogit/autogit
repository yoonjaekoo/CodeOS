#!/usr/bin/env bash
# ============================================================
#  AutoGit launcher (Linux / macOS)
#   1) ./autogit                          → 현재 폴더를 저장소로 TUI 실행
#   2) ./autogit <경로>                   → 지정한 Git 저장소로 TUI 실행
#   3) ./autogit <경로> <명령> [옵션]     → 지정 저장소에서 헤드리스 CLI
#   4) 전역 실행은 ./install.sh 실행 (PATH 에 autogit 등록)
# ============================================================
set -eu

APP_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"

# 첫 인자가 폴더면 저장소 경로로, 아니면 CLI 명령으로 넘긴다.
REPO="$PWD"
if [ "$#" -gt 0 ]; then
  if [ -d "$1" ]; then
    REPO="$1"
    shift
  else
    case "$1" in
      */*|*\\*|.*|~*)
        echo "[ERROR] 폴더를 찾을 수 없습니다: $1" >&2
        echo "사용법: ./autogit [Git 저장소 경로] [명령]" >&2
        exit 1
        ;;
    esac
  fi
fi

if [ ! -d "$REPO" ]; then
  echo "[ERROR] 폴더를 찾을 수 없습니다: $REPO" >&2
  echo "사용법: ./autogit [Git 저장소 경로]" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "[ERROR] Node.js (>= 18) 가 필요합니다. https://nodejs.org" >&2
  exit 1
fi

cd -- "$REPO"
exec node "$APP_DIR/bin/autogit.js" "$@"
